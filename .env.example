# Copy this file to .env for local use. Keep .env private and never commit it.
NODE_ENV=production
DATABASE_MODE=sqlite
AUTH_DATA_DIR=.local-data

# Resend: verify the sender domain in Resend before setting EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
# Set this to the URL users can reach (your temporary tunnel URL or production URL).
APP_URL=http://127.0.0.1:8000

# Optional Google sign-in. Leave blank to hide the Google sign-in buttons.
GOOGLE_CLIENT_ID=

# Optional Turso settings when DATABASE_MODE=turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Keep AUTH_PEPPER stable when using Turso or migrating existing accounts.
AUTH_PEPPER=
# Optional: a stable 32-byte key in 64-character hex or 43-character base64url.
BACKUP_ENCRYPTION_KEY=
