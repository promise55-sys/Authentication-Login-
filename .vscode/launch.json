{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app on port 8000",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "env": {
        "NODE_ENV": "production",
        "DATABASE_MODE": "sqlite",
        "AUTH_DATA_DIR": "${workspaceFolder}/.local-data",
        "PORT": "8000"
      },
      "serverReadyAction": {
        "pattern": "running at (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "console": "integratedTerminal"
    }
  ]
}
