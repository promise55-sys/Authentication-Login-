{
  "name": "den-promise-access",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive login and team access app with a Node.js API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate:turso": "node --env-file=.env.local scripts/migrate-to-turso.js",
    "restore:backup": "node scripts/restore-backup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.2.0",
    "google-auth-library": "^11.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
